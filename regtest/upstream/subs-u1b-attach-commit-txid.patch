+    /// Attach a known txid to the last local commitment (U1(b)), after
+    /// `attach::check_attach` accepts it against chain state read from
+    /// `spaced` now. The same txid again is a no-op. It sends nothing.
+    pub async fn attach_commit_txid(&self, space: &SLabel, txid: Txid) -> anyhow::Result<()> {
+        use crate::attach::{check_attach, ChainEvidence, WalletRecord};
+        use spaces_client::rpc::RpcClient;
+
+        let rpc = self.require_rpc()?;
+        let local_space = self.get_local_space(space)?;
+        let storage = local_space.storage();
+        let commitment = storage
+            .get_last_commitment()
+            .await?
+            .ok_or_else(|| anyhow!("no local commitment"))?;
+        if let Some(existing) = &commitment.commit_txid {
+            if *existing == txid.to_string() {
+                return Ok(());
+            }
+            return Err(anyhow!("the last commitment already has txid {}", existing));
+        }
+        let mut local_root = [0u8; 32];
+        hex::decode_to_slice(&commitment.root, &mut local_root)
+            .map_err(|e| anyhow!("invalid root: {}", e))?;
+
+        // Chain state, from spaced.
+        let info = rpc.get_server_info().await?;
+        let on_chain = rpc.get_commitment(space.clone().into(), None).await?;
+        let Some(fso) = get_subject_out(rpc, space).await? else {
+            return Err(anyhow!("subject not found: {}", space));
+        };
+        let sptr = NumId::from_spk::<Sha256>(fso.script_pubkey().clone());
+        let delegate = rpc.get_num(spaces_wallet::Subject::NumId(sptr)).await?;
+        let chain = ChainEvidence {
+            synced: info.ready && info.chain.blocks == info.chain.headers,
+            commitment: on_chain.map(|c| (c.state_root, c.block_height)),
+            delegate: delegate.map(|d| (d.txid, d.numout.n, d.numout.spent, d.numout.num.last_update)),
+        };
+
+        // The operator wallet's record of the txid, if it has one.
+        let mut wallet = None;
+        let mut skip = 0;
+        'pages: loop {
+            let page = rpc.wallet_list_transactions(&self.wallet, 100, skip).await?;
+            if page.is_empty() {
+                break;
+            }
+            for tx in &page {
+                if tx.txid != txid {
+                    continue;
+                }
+                let commit_roots = tx
+                    .events
+                    .iter()
+                    .filter_map(|ev| {
+                        let v = serde_json::to_value(ev).ok()?;
+                        if v.get("type")?.as_str()? != "commit_root" {
+                            return None;
+                        }
+                        let root = v.get("root")?.as_str()?.to_string();
+                        let event_space = v.get("space").and_then(|s| s.as_str()).map(String::from);
+                        Some((event_space, root))
+                    })
+                    .collect();
+                wallet = Some(WalletRecord { block_height: tx.block_height, commit_roots });
+                break 'pages;
+            }
+            skip += page.len();
+        }
+
+        check_attach(&space.to_string(), &local_root, &txid, &chain, wallet.as_ref())
+            .map_err(|reason| anyhow!("cannot attach {}: {}", txid, reason))?;
+        storage
+            .update_commitment_txid(commitment.id, &txid.to_string())
+            .await?;
+        Ok(())
+    }
