+#[derive(Deserialize)]
+pub struct AttachTxidBody {
+    pub txid: String,
+}
+
+/// POST /spaces/:space/commit/txid - Attach a known txid to the last local
+/// commitment (U1(b)), after checking it against chain state. Sends nothing.
+pub async fn attach_commit_txid(
+    State(state): State<AppState>,
+    Path(space): Path<String>,
+    Json(body): Json<AttachTxidBody>,
+) -> Result<Json<BroadcastResponse>, Response> {
+    let space = space
+        .parse()
+        .map_err(|e| json_error(StatusCode::BAD_REQUEST, format!("invalid space: {}", e)))?;
+    let txid: bitcoin::Txid = body
+        .txid
+        .parse()
+        .map_err(|e| json_error(StatusCode::BAD_REQUEST, format!("invalid txid: {}", e)))?;
+    state
+        .operator
+        .attach_commit_txid(&space, txid)
+        .await
+        .map_err(|e| json_error(StatusCode::CONFLICT, e))?;
+    Ok(Json(BroadcastResponse { txid: txid.to_string() }))
+}
