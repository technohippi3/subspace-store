@@ -0,0 +1,190 @@
+//! U1(b): attach a known txid to the last local commitment.
+//!
+//! After a restore from a snapshot that predates the broadcast, or after the
+//! answer to `/broadcast` was lost, a commitment can be on chain while
+//! `commit_txid` is empty. For a commitment after the first,
+//! `can_commit_local` then refuses every further local commit. The check
+//! here decides, from authoritative chain state read from `spaced`, whether
+//! a given txid is the transaction that made this space's commitment:
+//!
+//! - `spaced` is ready and synced to its node's headers, so its view is not
+//!   stale;
+//! - the space's on-chain commitment carries the local root, at height H;
+//! - the space's delegate output is output 0 of the given txid, unspent and
+//!   last updated at H. A commitment spends the delegate output and makes
+//!   the new one at output 0, so only the transaction that committed at H
+//!   can be named there.
+//!
+//! The operator wallet's record of the txid, where it has one, must not
+//! contradict that: a record for another space, another root or another
+//! height refuses. A missing record doesn't, because a restored wallet may
+//! not keep its event history. Nothing here sends anything.
+
+use bitcoin::Txid;
+
+/// What `spaced` reports about the space, read just before the check.
+#[derive(Clone, Debug)]
+pub struct ChainEvidence {
+    /// `getserverinfo`: `ready`, and `chain.blocks == chain.headers`.
+    pub synced: bool,
+    /// `getcommitment(space)`: the on-chain state root and its block height.
+    pub commitment: Option<([u8; 32], u32)>,
+    /// `getnum(delegate)`: the delegate output's txid, output index, whether
+    /// it is spent, and the height of its last update.
+    pub delegate: Option<(Txid, usize, bool, u32)>,
+}
+
+/// The operator wallet's record of the txid, if it has one.
+#[derive(Clone, Debug)]
+pub struct WalletRecord {
+    pub block_height: Option<u32>,
+    /// `(space, root)` of each commit-root event on the transaction.
+    pub commit_roots: Vec<(Option<String>, String)>,
+}
+
+/// Whether `txid` may be attached to the last local commitment of `space`,
+/// whose root is `local_root`. Returns the reason when it may not.
+pub fn check_attach(
+    space: &str,
+    local_root: &[u8; 32],
+    txid: &Txid,
+    chain: &ChainEvidence,
+    wallet: Option<&WalletRecord>,
+) -> Result<(), String> {
+    if !chain.synced {
+        return Err("spaced is not synced to its node; its chain state may be stale".into());
+    }
+    let (root, height) = chain
+        .commitment
+        .ok_or_else(|| "no commitment on chain for this space".to_string())?;
+    if &root != local_root {
+        return Err("the on-chain commitment root doesn't match the last local commitment".into());
+    }
+    let (delegate_txid, vout, spent, last_update) = chain
+        .delegate
+        .ok_or_else(|| "no delegate output found for this space".to_string())?;
+    if &delegate_txid != txid || vout != 0 {
+        return Err(format!(
+            "{} didn't make this space's delegate output, which is {}:{}",
+            txid, delegate_txid, vout
+        ));
+    }
+    if spent {
+        return Err("this space's delegate output is spent".into());
+    }
+    if last_update != height {
+        return Err(format!(
+            "the delegate output was last updated at {}, not at the commitment's height {}",
+            last_update, height
+        ));
+    }
+    if let Some(record) = wallet {
+        if let Some(h) = record.block_height {
+            if h != height {
+                return Err(format!("the wallet has {} at height {}, not {}", txid, h, height));
+            }
+        }
+        let root_hex = hex::encode(local_root);
+        for (event_space, event_root) in &record.commit_roots {
+            let other_space = event_space.as_deref().map(|s| s != space).unwrap_or(false);
+            if other_space || !event_root.eq_ignore_ascii_case(&root_hex) {
+                return Err(format!(
+                    "the wallet records {} as committing {} for {}",
+                    txid,
+                    event_root,
+                    event_space.as_deref().unwrap_or("an unnamed space")
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitcoin::hashes::Hash;
+
+    const SPACE: &str = "@test10000";
+    const ROOT: [u8; 32] = [7u8; 32];
+    const H: u32 = 3600;
+
+    fn txid(b: u8) -> Txid {
+        Txid::from_byte_array([b; 32])
+    }
+
+    fn good() -> ChainEvidence {
+        ChainEvidence {
+            synced: true,
+            commitment: Some((ROOT, H)),
+            delegate: Some((txid(1), 0, false, H)),
+        }
+    }
+
+    fn wallet(height: u32, space: &str, root: &[u8; 32]) -> WalletRecord {
+        WalletRecord {
+            block_height: Some(height),
+            commit_roots: vec![(Some(space.to_string()), hex::encode(root))],
+        }
+    }
+
+    #[test]
+    fn the_transaction_that_made_the_delegate_output_is_attached() {
+        assert_eq!(check_attach(SPACE, &ROOT, &txid(1), &good(), None), Ok(()));
+        let w = wallet(H, SPACE, &ROOT);
+        assert_eq!(check_attach(SPACE, &ROOT, &txid(1), &good(), Some(&w)), Ok(()));
+    }
+
+    #[test]
+    fn copied_root_bytes_are_not_enough() {
+        // Any other transaction, whatever bytes it carries, didn't make the
+        // delegate output.
+        assert!(check_attach(SPACE, &ROOT, &txid(2), &good(), None).is_err());
+    }
+
+    #[test]
+    fn another_spaces_commitment_is_refused() {
+        // Its txid isn't this space's delegate output.
+        assert!(check_attach(SPACE, &ROOT, &txid(9), &good(), None).is_err());
+        // And a wallet record naming another space contradicts the chain.
+        let w = wallet(H, "@test9999", &ROOT);
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &good(), Some(&w)).is_err());
+    }
+
+    #[test]
+    fn a_wrong_height_is_refused() {
+        let mut chain = good();
+        chain.delegate = Some((txid(1), 0, false, H + 1));
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+        let w = wallet(H - 6, SPACE, &ROOT);
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &good(), Some(&w)).is_err());
+    }
+
+    #[test]
+    fn stale_or_missing_chain_evidence_is_refused() {
+        let mut chain = good();
+        chain.synced = false;
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+        let mut chain = good();
+        chain.commitment = None;
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+        let mut chain = good();
+        chain.delegate = None;
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+    }
+
+    #[test]
+    fn a_different_root_or_output_is_refused() {
+        let mut chain = good();
+        chain.commitment = Some(([8u8; 32], H));
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+        let mut chain = good();
+        chain.delegate = Some((txid(1), 1, false, H));
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+        let mut chain = good();
+        chain.delegate = Some((txid(1), 0, true, H));
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &chain, None).is_err());
+        let w = wallet(H, SPACE, &[8u8; 32]);
+        assert!(check_attach(SPACE, &ROOT, &txid(1), &good(), Some(&w)).is_err());
+    }
+}
