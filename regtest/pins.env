# Pinned upstream versions for the regtest harness.
#
# subs and spaces are the versions pinned in docs/spec/CONTROLLER-DESIGN.md.
# Bitcoin Core 31.2 is a maintained release and the version the store's own
# node runs. Every regtest scenario set passed on it on 2026-11-11
# (regtest/REPORT.md). Until then the pin was 26.0, the version that spaces'
# own test utilities pin (`bitcoind = { version = "0.36.0", features =
# ["26_0"] }` in the spaces workspace at v0.5.0); 26.0 reached end of life on
# 2025-04-14. The preset regtest chain still comes from that tag, and 31.2
# opens it: its wallets are SQLite descriptor wallets.
# An upgrade is an explicit change to this file with its own regtest run.

SUBS_REPO=https://github.com/spacesprotocol/subs
SUBS_COMMIT=4dcc9237af3a807497d4b1532729842ee5dcdb68

SPACES_REPO=https://github.com/spacesprotocol/spaces
SPACES_TAG=spaces_client-v0.5.0
SPACES_COMMIT=77653f01889ddc86337e4b27d7d3ae4fc334a117

BITCOIN_VERSION=31.2
BITCOIN_TARBALL=bitcoin-31.2-x86_64-linux-gnu.tar.gz
BITCOIN_URL=https://bitcoincore.org/bin/bitcoin-core-31.2/bitcoin-31.2-x86_64-linux-gnu.tar.gz
BITCOIN_SHA256=2f38996afaa74dfa469a23bf4727887133dfc09784df1f21ddf1c74d0dc82300

# certrelay at the commit that subs' Cargo.lock locks for its test-rig relay
# (`relay` and `fabric-resolver` from certrelay.git). build-relay.sh builds
# its `certrelay` binary with certrelay's own Cargo.lock at that commit,
# which locks the same libveritas 0.4.4 and spaces 0.4.2 crates as subs.
CERTRELAY_REPO=https://github.com/spacesprotocol/certrelay
CERTRELAY_COMMIT=fb446487af4f9702109999f96d2ec11d3dd0b0ef
