{
  "name": "subspace-store",
  "private": true,
  "type": "module",
  "description": "TypeScript port and standalone regtest runtime of the subspace store, pre-alpha.",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:core": "../regtest/in-netns.sh env SUBSPACE_CORE_REGTEST_ISOLATED=1 node --test regtest/core.test.ts",
    "test:core:ci": "../regtest/in-netns-ci.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@spacesprotocol/libveritas": "0.4.4",
    "effect": "4.1.4"
  }
}
